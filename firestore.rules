rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isBootstrapTeacher() {
      return signedIn()
        && (
          request.auth.uid in [
            'hzSKwkaroTR1LKcXp09E5wL7F6f1'
          ]
          || request.auth.token.email == 'phamkhuong436@gmail.com'
        );
    }

    // Bootstrap teacher access by creating:
    // /teachers/{teacherUid} => { active: true, role: "teacher" }
    // from Firebase Console or Admin SDK. Client writes are intentionally blocked.
    function isTeacher() {
      return isBootstrapTeacher()
        || (
          signedIn()
          && exists(/databases/$(database)/documents/teachers/$(request.auth.uid))
          && get(/databases/$(database)/documents/teachers/$(request.auth.uid)).data.active == true
        );
    }

    function isTeacherAttemptReview(userId) {
      return isTeacher()
        && resource.data.userId == userId
        && request.resource.data.userId == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'isCorrect',
          'gradingMode',
          'teacherFeedback',
          'syncedAt'
        ])
        && request.resource.data.isCorrect is bool
        && request.resource.data.gradingMode == 'auto';
    }

    function isTeacherProgressWrite() {
      return isTeacher()
        && request.resource.data.keys().hasOnly([
          'masteryLevel',
          'isCompleted',
          'updatedAt'
        ])
        && request.resource.data.masteryLevel is number
        && request.resource.data.masteryLevel >= 0
        && request.resource.data.masteryLevel <= 100
        && request.resource.data.isCompleted is bool
        && request.resource.data.updatedAt is string;
    }

    function isTeacherMistakeCreate(userId) {
      return isTeacher()
        && request.resource.data.userId == userId
        && request.resource.data.keys().hasOnly([
          'id',
          'userId',
          'questionId',
          'questionTypeId',
          'wrongAnswer',
          'proofImages',
          'reviewStatus',
          'reviewCount',
          'lastAttemptedAt',
          'nextReviewAt',
          'teacherFeedback',
          'syncedAt'
        ])
        && request.resource.data.reviewStatus in ['new', 'reviewing', 'fixed'];
    }

    function isTeacherMistakeUpdate(userId) {
      return isTeacher()
        && resource.data.userId == userId
        && request.resource.data.userId == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'reviewStatus',
          'nextReviewAt',
          'teacherFeedback',
          'syncedAt'
        ])
        && request.resource.data.reviewStatus in ['new', 'reviewing', 'fixed'];
    }

    match /teachers/{teacherId} {
      allow get: if signedIn() && request.auth.uid == teacherId;
      allow list, create, update, delete: if false;
    }

    match /transactions/{transactionId} {
      allow get, list: if signedIn() && (resource.data.userId == request.auth.uid || resource.data.sellerUid == request.auth.uid || isTeacher());
      allow create, update, delete: if false;
    }

    match /affiliateCodes/{code} {
      allow get: if signedIn();
      allow list: if isTeacher() || (signedIn() && resource.data.sellerUid == request.auth.uid);
      allow create: if isTeacher() || (
        signedIn()
        && request.resource.data.sellerUid == request.auth.uid
        && request.resource.data.discountPercent >= 0
        && request.resource.data.discountPercent <= 75
        && request.resource.data.discountPercent + request.resource.data.commissionPercent == 75
      );
      allow update: if isTeacher() || (
        signedIn()
        && resource.data.sellerUid == request.auth.uid
        && request.resource.data.discountPercent >= 0
        && request.resource.data.discountPercent <= 75
        && request.resource.data.discountPercent + request.resource.data.commissionPercent == 75
        && request.resource.data.diff(resource.data).affectedKeys().hasAny(['isActive', 'discountPercent', 'commissionPercent'])
      );
      allow delete: if isTeacher();
    }

    match /affiliateWallets/{sellerUid} {
      allow get: if isTeacher() || (signedIn() && request.auth.uid == sellerUid);
      allow list: if isTeacher();
      allow create: if isTeacher() || (
        signedIn()
        && request.auth.uid == sellerUid
        && request.resource.data.balance == 0
        && request.resource.data.totalEarned == 0
        && request.resource.data.pendingBalance == 0
      );
      allow update: if isTeacher() || (
        signedIn()
        && request.auth.uid == sellerUid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['bankAccount'])
      );
      allow delete: if false;
    }

    match /payoutRequests/{requestId} {
      allow get, list: if isTeacher() || (signedIn() && resource.data.sellerUid == request.auth.uid);
      allow write: if isTeacher();
    }

    match /student_profiles/{userId} {
      allow read: if isOwner(userId) || isTeacher();
      allow write: if false;
    }

    match /ai_usage_logs/{logId} {
      allow read: if isTeacher();
      allow write: if false;
    }

    match /system_stats/{docId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /users/{userId} {
      allow get: if isOwner(userId) || isTeacher();
      allow list: if isTeacher();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || (isTeacher() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['completedCount']));
      allow delete: if false;

      match /progress/{progressId} {
        allow read, write: if isOwner(userId);
        allow read: if isTeacher();
        allow create, update: if isTeacherProgressWrite();
        allow delete: if false;
      }

      match /attempts/{attemptId} {
        allow read, write: if isOwner(userId);
        allow read: if isTeacher();
        allow update: if isTeacherAttemptReview(userId);
        allow create, delete: if false;
      }

      match /topic_attempts/{questionTypeId} {
        allow read, write: if isOwner(userId);
        allow read: if isTeacher();
      }

      match /mistakes/{mistakeId} {
        allow read, write: if isOwner(userId);
        allow read: if isTeacher();
        allow create: if isTeacherMistakeCreate(userId);
        allow update: if isTeacherMistakeUpdate(userId);
        allow delete: if false;
      }

      match /active_mistakes/{docId} {
        allow read, write: if isOwner(userId);
        allow read: if isTeacher();
      }

      match /exam_results/{examResultId} {
        allow read, write: if isOwner(userId);
        allow read: if isTeacher();
        allow create, update, delete: if false;
      }

      match /chats/{chatId} {
        allow read, write: if isOwner(userId);
        allow read: if isTeacher();
        allow delete: if isOwner(userId);
      }

      match /general_chats/{chatId} {
        allow read, write: if isOwner(userId);
        allow read: if isTeacher();

        match /sessions/{sessionId} {
          allow read, write: if isOwner(userId);
          allow read: if isTeacher();
        }
      }

      match /tickets/{ticketId} {
        allow create: if userId == 'guests' || isOwner(userId);
        allow read, update, delete: if isOwner(userId) || isTeacher();
      }
    }

    match /{path=**}/tickets/{ticketId} {
      allow read, write: if isTeacher();
    }

    match /survey_responses/{userId} {
      allow read, write: if isOwner(userId) || isTeacher();
      allow list: if isTeacher();
    }

    match /system_metrics/{docId} {
      allow read: if signedIn();
      allow write: if signedIn();
    }

    match /system_notifications/{docId} {
      allow read: if signedIn();
      allow write: if signedIn();
    }

    match /manual_attempts/{attemptId} {
      allow read, delete: if isTeacher();
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if false;
    }

    match /announcement_posts/{postId} {
      allow read: if true;
      allow create, update: if signedIn();
      allow delete: if isTeacher();
    }
  }
}
